{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ESP32 Debug (OpenOCD)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/esp32/${workspaceFolderBasename}/build/${workspaceFolderBasename}.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${env:HOME}/.espressif/tools/xtensa-esp32-elf-gdb/bin/xtensa-esp32-elf-gdb",
      "miDebuggerServerAddress": "localhost:3333",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "ESP-IDF: Build project"
    },
    {
      "name": "Pico Debug (OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}/pico/${workspaceFolderBasename}",
      "executable": "${workspaceFolder}/pico/${workspaceFolderBasename}/build/${workspaceFolderBasename}.elf",
      "servertype": "openocd",
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/rp2040.cfg"
      ],
      "svdFile": "${env:PICO_SDK_PATH}/src/rp2040/hardware_regs/rp2040.svd",
      "runToEntryPoint": "main",
      "gdbPath": "arm-none-eabi-gdb",
      "device": "RP2040",
      "preLaunchTask": "Pico: Build project"
    },
    {
      "name": "Pico Debug (Picoprobe)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}/pico/${workspaceFolderBasename}",
      "executable": "${workspaceFolder}/pico/${workspaceFolderBasename}/build/${workspaceFolderBasename}.elf",
      "servertype": "openocd",
      "configFiles": [
        "interface/picoprobe.cfg",
        "target/rp2040.cfg"
      ],
      "svdFile": "${env:PICO_SDK_PATH}/src/rp2040/hardware_regs/rp2040.svd",
      "runToEntryPoint": "main",
      "gdbPath": "arm-none-eabi-gdb",
      "device": "RP2040"
    }
  ]
}
